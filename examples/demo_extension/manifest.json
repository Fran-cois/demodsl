{
  "manifest_version": 3,
  "name": "DemoDSL Highlighter",
  "version": "1.0.0",
  "description": "Demo extension — highlights links on the page, controlled from its popup.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
